# mTLS reverse proxy in front of the E2E Home Assistant. Mounted as
# /etc/nginx/templates/default.conf.template, the nginx image renders it with
# envsubst into conf.d, inside its own http block (hence only a server block
# here, and the access log on stdout comes from the image's defaults).
# E2E_MTLS_UPSTREAM is the host:port of Home Assistant; the certificates come
# from generate-certs.sh, mounted at /etc/nginx/certs.
server {
    listen 8443 ssl;

    ssl_certificate /etc/nginx/certs/server.pem;
    ssl_certificate_key /etc/nginx/certs/server.key;

    # "on" rather than "optional": every request, including the first GET the
    # onboarding WebView makes, must carry the client certificate. That is
    # what makes the WebView ask for one before anything renders.
    ssl_client_certificate /etc/nginx/certs/ca.pem;
    ssl_verify_client on;

    location / {
        proxy_pass http://${E2E_MTLS_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
