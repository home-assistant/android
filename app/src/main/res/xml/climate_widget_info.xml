<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:configure="io.homeassistant.companion.android.widgets.climate.ClimateWidgetConfigureActivity"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="110dp"
    android:resizeMode="vertical|horizontal"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetFeatures="reconfigurable"
    android:description="@string/climate_widget_desc"
    android:widgetCategory="keyguard|home_screen"
    android:previewImage="@drawable/widget_example_climate"
    tools:ignore="UnusedAttribute,UnusedResources" />
